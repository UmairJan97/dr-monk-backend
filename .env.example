APP_NAME="Dr Monk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dr_monk
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@drmonk.health"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# --- Clinic / EMR ---
CLINIC_TIMEZONE=America/New_York
CLINIC_CURRENCY=USD
PHI_SIGNED_URL_MINUTES=5

# NP/Doctor e-prescribe: * = all states, or comma list e.g. NY,CA,TX
PRESCRIBE_ALLOWED_STATES=*
DEFAULT_LICENSE_STATE=NY

# --- AI ---
AI_EXTERNAL_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=whisper-1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- E-Prescribe (NCPDP / Surescripts) ---
SURESCRIPTS_MODE=sandbox
SURESCRIPTS_API_KEY=
SURESCRIPTS_ENDPOINT=

# --- Clearinghouse / X12 ---
CLEARINGHOUSE_MODE=sandbox
CLEARINGHOUSE_API_KEY=
CLEARINGHOUSE_ENDPOINT=
CLEARINGHOUSE_SUBMITTER_ID=DRMNK

# --- SMS (reminders, no PHI) ---
SMS_MODE=sandbox
SMS_PROVIDER=log
SMS_FROM=

# --- Stripe (clinic payments + future SaaS) ---
STRIPE_MODE=sandbox
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
